{
  "name": "@metaxia/scriptures-source-stepbible-lexicon",
  "version": "0.1.1",
  "description": "Hebrew and Greek lexicon data from STEPBible for @metaxia/scriptures. Includes TBESH (Hebrew/BDB), TBESG (Greek/Abbott-Smith), and TFLSJ (Greek/LSJ) lexicons with Strong's number lookup.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./data/*": "./data/*"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "import": "tsx scripts/import.ts",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist data"
  },
  "keywords": [
    "bible",
    "lexicon",
    "strongs",
    "hebrew",
    "greek",
    "bdb",
    "lsj",
    "stepbible",
    "scriptures"
  ],
  "author": "Benjamin Plunkert",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/metaxiamultimedia/scriptures-js-source-stepbible-lexicon"
  },
  "bugs": {
    "url": "https://github.com/metaxiamultimedia/scriptures-js-source-stepbible-lexicon/issues"
  },
  "homepage": "https://github.com/metaxiamultimedia/scriptures-js-source-stepbible-lexicon#readme",
  "peerDependencies": {
    "@metaxia/scriptures-core": ">=0.1.0"
  },
  "devDependencies": {
    "@metaxia/scriptures-core": "^0.1.1",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.0"
  }
}
